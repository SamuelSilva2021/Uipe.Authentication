@page "/ResetPassword"
@model Authentication.Pages.ResetPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Reset de Senha</title>
    <style>

        body {
            font-family: 'Arial', sans-serif;
            background-color: #f8f9fa;
        }

        .container {
            margin-top: 50px;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        .card {
            border: 1px solid #c7baa3;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            background-color: #f5f7de;
        }

        .card-header {
            background-color: #063f7c;
            color: #ffffff;
            text-align: center;
            padding: 10px;
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }

        .card-body {
            padding: 20px;
        }

        label {
            font-weight: bold;
            margin-bottom: 5px;
            color: #063f7c;
        }

        input {
            width: 100%;
            padding: 8px;
            margin-bottom: 15px;
            box-sizing: border-box;
            border: 1px solid #063f7c;
            border-radius: 5px;
        }

        button {
            background-color: #063f7c;
            color: #ffffff;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

            button:hover {
                background-color: #0056b3;
            }
    </style>
</head>
<body>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        Criar nova senha
                    </div>
                    <div class="card-body">
                        <form action="/api/auth/resetpassword" method="post" enctype="application/x-www-form-urlencoded">
                            <input type="hidden" name="Token" value="@Request.Query["Token"]" />
                            <input type="hidden" name="Email" value="@Request.Query["Email"]" />
                            <label for="novaSenha">Nova Senha</label>
                            <input type="password" id="novaSenha" name="NewPassword" required>
                            <label for="confirmarSenha">Confirmar Senha</label>
                            <input type="password" id="confirmarSenha" name="ConfirmPassword" required>
                            <button type="submit">Confirmar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
